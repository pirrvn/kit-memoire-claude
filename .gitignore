.DS_Store
__pycache__/

# Documents de l'école : restent sur ta machine
consignes/originaux/*
!consignes/originaux/.gitkeep

# Textes intégraux téléchargés (droits d'auteur) : restent sur ta machine
sources/pdf/*
!sources/pdf/.gitkeep

# Notices brutes des recherches systématiques (volumineuses, regénérables)
*.jsonl
*.jsonl.gz

# Par sécurité, si un dossier de terrain brut était créé par erreur dans le projet
terrain/prive/
terrain/brut/

# Réglages personnels locaux de Claude Code
.claude/settings.local.json

# Fichiers temporaires de Word
~$*
